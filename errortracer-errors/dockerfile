FROM rust:1.89-bookworm AS builder
WORKDIR /usr/src/app
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake clang libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock* ./
COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/src/app/target \
    cargo build --release --locked \
    && cp target/release/errortracer-errors /tmp/errortracer-errors

FROM debian:bookworm-slim AS production
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home errortracer
COPY --from=builder /tmp/errortracer-errors /usr/local/bin/errortracer-errors
USER errortracer
EXPOSE 4974
ENTRYPOINT ["/usr/local/bin/errortracer-errors"]

FROM builder AS development
RUN cargo install cargo-watch --locked
CMD ["cargo", "watch", "-x", "run"]

FROM builder AS test
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/src/app/target \
    cargo test --release --locked
